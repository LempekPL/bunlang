fn main() {
    let a = 10;
    let b = a * 2;
    a = a + (b * 100);
    a += 1;
    if a > 18 {
        io::println("jepi ", a);
    } else if a == 18 {
        io::println("prawie ", a);
    } else {
        io::println("spierdalaj ", a);
    }
    let i = 0;
    while i < 100 {
        io::print(i, ". ");
        if i % 3 == 0 && i % 5 == 0 {
            io::print("baz");
        } else if i % 3 == 0 {
            io::print("foo");
        } else {
            i += 2;
            io::println();
            continue;
        }
        if (i - 1) == 10 {
            break;
        }
        i += 1;
        io::println();
    }
    // c::test()
}
