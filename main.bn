fn trolujN(a) {
    io::println("troluje ", a, " razy");
}

fn main() {
    let a = 10;
    let b = a * 2;
    a = a + (b * 100);
    a += 1;
    if a > 18 {
        io::println("jepi ", a);
    } else if a == 18 {
        io::println("prawie ", a);
    } else {
        io::println("spierdalaj ", a);
    }
    let i = 0;
    let a = "królik";
    let ilosc = io::read();
    while i < 10 {
        io::println(i, ". " + a);
        trolujN(i);
        trolujN(ilosc);
        i += 1;
    }
    // c::test()
}
