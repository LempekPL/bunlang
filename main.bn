enum Option {
    None,
    Some(value)
}

mod lol {
    pub fn test() {
        io::println(Option::Some(40));
    }
}

use lol;

fn add(a, b) {
    return a + b;
}

fn main() {
    test();
    let none = Option::None;
    io::println(none);

    let some = Option::Some(42);
    io::println(some);
}
